# Copy this to .env and fill in values. Used by docker compose.
# The encryption key for your stored Steam session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   # or without node: openssl rand -hex 32
SKINHQ_SESSION_KEY=
# Optional CSFloat API key (create one at csfloat.com/api). Enables the
# CSFloat price column in the grid. Without it that column stays empty.
CSFLOAT_API_KEY=
# How often the server auto-syncs (inventory, listings, prices) on its own, in
# minutes. Default 60. Set to 0 to disable auto-sync and only sync via
# "Sync now". Runs never overlap and the price phase skips items that were
# refreshed within SYNC_PRICE_FRESH_MS, so frequent cadences are cheap.
SYNC_INTERVAL_MIN=60